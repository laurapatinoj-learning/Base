{
  "name": "base-parkway",
  "version": "1.0.0",
  "description": "Base Parkway — plataforma editorial y académica: CMS, catálogo, tienda, aula, agenda, newsletter y analítica.",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/reset.js",
    "test": "node --disable-warning=ExperimentalWarning test/smoke.mjs",
    "build:pdfs": "node scripts/export-content.mjs && python3 scripts/make_pdfs.py"
  }
}
